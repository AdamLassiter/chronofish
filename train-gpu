#!/usr/bin/env sh
set -eu

echo "Training local GPU value and policy model."
echo "Pass --gpu-train-search or --gpu-train-samples to collect or load training data."
if [ "$#" -eq 0 ]; then
  exec cargo run --release --manifest-path engine/Cargo.toml --features neural-wgpu --bin gpu -- \
    --gpu-train-search --gpu-sample-count 128 \
    --gpu-model engine/models/gpu-v1/value-model.cfnn \
    --out engine/models/gpu-v1/value-model.cfnn
fi
exec cargo run --release --manifest-path engine/Cargo.toml --features neural-wgpu --bin gpu -- "$@"
