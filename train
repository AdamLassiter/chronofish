#!/usr/bin/env sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
ENGINE="$ROOT/engine/Cargo.toml"

TIME_SECONDS="${TRAIN_TIME_SECONDS:-300}"
VERIFY="${TRAIN_VERIFY:-cargo test -q}"

while :; do
  cargo run --release --manifest-path "$ENGINE" --bin train -- \
    --train-cycle \
    --time-seconds "$TIME_SECONDS" \
    --verify "$VERIFY" \
    "$@"
done
