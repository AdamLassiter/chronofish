#!/usr/bin/env sh
set -eu

if [ "${1:-}" = "cpu" ]; then
  shift
  exec ./train-cpu "$@"
fi

if [ "${1:-}" = "gpu" ]; then
  shift
  exec ./train-gpu "$@"
fi

echo "Frontend WebGPU training is served by the dev server with training endpoints enabled."
echo "Open the app and use the Neural training modal."
echo "For native heuristic CPU training, run: ./train-cpu train --max-seconds 3600"
echo "For native GPU training, run: ./train-gpu train --source search [snapshot.json]"

npm --prefix web ci
npm --prefix web run build
cargo build --release --manifest-path engine/Cargo.toml --target wasm32-unknown-unknown
exec cargo run --features frontend-training --bin chronofish-server
